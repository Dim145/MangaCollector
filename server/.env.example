# Server
PORT=3000

# Auth — set AUTH_MODE to "google" or "openidconnect"
AUTH_MODE=google
AUTH_CLIENT_ID=your-client-id
AUTH_CLIENT_SECRET=your-client-secret

# Only required when AUTH_MODE=openidconnect
# AUTH_ISSUER=https://your-oidc-provider.example.com

# Display name and icon shown on the login page.
# AUTH_NAME is the provider's name, printed in "Continue with ...".
# AUTH_ICON is either the literal `google` (draws the Google mark) or a
# URL to an image — http(s):// or a path starting with /. Anything else
# falls back to a generic key glyph; it used to be handed straight to
# <img src> and rendered as a broken image.
AUTH_NAME=Google
AUTH_ICON=google

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# URLs
FRONTEND_URL=http://localhost:12000

# Database
POSTGRES_URL=postgres://user:password@localhost:5432/manga_collector

# Storage — leave all S3_* unset to use local filesystem instead
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=manga-collector
S3_REGION=us-east-1
S3_USE_SSL=false
S3_USE_PATH_STYLE=true

# Local storage fallback (used when S3 vars are not set)
STORAGE_DIR=./storage

# Health check — set to "true" to allow health check from any IP
APP_UNSECURE_HEALTHCHECK=false

# ── Backend error tracking (Sentry / Bugsink) ───────────────────────
# Pick exactly ONE provider. Setting both DSNs aborts startup.
# Leaving both unset disables backend error tracking entirely.
#
# SENTRY_DSN works for the official Sentry cloud OR a self-hosted
# Sentry instance — both speak the same protocol.
# SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/0000000
#
# BUGSINK_DSN points at a self-hosted Bugsink instance (wire-compatible
# with the Sentry SDK).
# BUGSINK_DSN=https://xxxxxxxx@bugsink.example.com/0
#
# Optional metadata applied to every event.
# SENTRY_ENVIRONMENT=production
#
# Performance traces — float in [0.0, 1.0]. 0.0 = errors only (default).
# 0.1 = sample 10% of requests as transactions.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Frontend integrations (served to the SPA at runtime) ────────────
# Two distinct injection paths, both env-driven (no rebuild on change):
#
# 1. Umami — read by the NGINX container's entrypoint, substituted via
#    envsubst into index.html and the CSP header at startup. Synchronous
#    availability means pageviews are tracked from the very first
#    navigation, no fetch round-trip.
#
# 2. Sentry / Bugsink — read by the BACKEND, served to the SPA via
#    GET /api/public-config (cached aggressively by the service worker
#    for offline boots). Init is non-blocking: React mounts immediately
#    and the SDK is wired when the response arrives. On any failure
#    (network, 5xx, no cache on first install) the SDK silently stays
#    off — the core app remains usable.

# Analytics — Umami. Both must be set for the script tag to inject.
# SPA route changes are auto-tracked (history.pushState hook).
# FRONTEND_UMAMI_SCRIPT_URL=https://umami.example.com/script.js
# FRONTEND_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
#
# Optional override — if your Umami origin differs from the script URL
# (rare; typical setups have script on the analytics origin). Defaults
# to the scheme+host of FRONTEND_UMAMI_SCRIPT_URL.
# FRONTEND_UMAMI_ORIGIN=https://umami.example.com

# Frontend error tracking — same mutex as the backend (validated at
# boot, server refuses to start if both are set). Independent from the
# backend DSN: typical setups use one Sentry/Bugsink project per
# service, but pointing both at the same project also works.
# FRONTEND_SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/0000000
# FRONTEND_BUGSINK_DSN=https://xxxxxxxx@bugsink.example.com/0

# Optional metadata.
# FRONTEND_SENTRY_ENVIRONMENT=production
# FRONTEND_SENTRY_RELEASE=2.9.0
# FRONTEND_SENTRY_TRACES_SAMPLE_RATE=0.0
# FRONTEND_SENTRY_REPLAY=false

# ── 接 · MCP endpoint (/mcp) ────────────────────────────────────────
# Lets an AI client read and curate the collection through per-user API
# keys, minted from Réglages → Accès API. Opt-in: it hands an agent write
# access to a whole library, so a deploy never turns it on by surprise.
MCP_ENABLED=false
# Host values the transport answers to, on top of the loopback defaults.
# rmcp validates `Host` to block DNS rebinding — without the deployment's
# own hostname in here every request is refused. Comma-separated; an
# entry without a port matches any port, with one it must match exactly.
MCP_ALLOWED_HOSTS=
# Origin values to accept. Empty means "do not check", which is right for
# an endpoint that takes no cookie and is not reachable from a browser
# session.
MCP_ALLOWED_ORIGINS=
# Per-key token bucket. Keyed on the key's public prefix rather than the
# client IP, so several clients behind one NAT do not share a budget.
MCP_RATE_LIMIT_PER_SECOND=1
MCP_RATE_LIMIT_BURST=20

# 源 · Where MyAnimeList data comes from.
# The base of a Jikan v4 gateway, version included. Empty = the public
# https://api.jikan.moe/v4. Set it to a mirror when the public one is down
# or slow; a self-hosted one may be plain http on your network.
# Mirrors with Jikan's routes but their own JSON are understood too, e.g.
# jikan-edge: JIKAN_API_URL=https://jikan.lucashdo.com/v1 (its user lists
# count chapters, so an import by username through it carries no volume
# counts — MAL_CLIENT_ID does).
JIKAN_API_URL=
# A MyAnimeList API client id (https://myanimelist.net/apiconfig — "Create
# ID", any app type). Set, it switches search, series details, covers,
# recommendations and the import by username to the official API, with
# Jikan as the fallback when MAL fails. Authors and characters stay on
# Jikan: the official API has neither. Only the client id is needed — the
# public endpoints take no secret and no user login. Empty = off.
MAL_CLIENT_ID=

# 影 · Relay series covers through this server instead of letting the
# browser fetch them from MyAnimeList and MangaDex, which hands those
# CDNs a reader's address once per cover. Off by default: turning it on
# moves those megabytes onto this server's connection.
# Measured caveat: MyAnimeList serves the relay, MangaDex refuses it
# (HTTP/2 ENHANCE_YOUR_CALM, on the first request, whatever the rate),
# and the browser falls back to fetching those directly.
PROXY_COVERS=false

# 源 · Behind a reverse proxy you control, set TRUST_PROXY_HEADERS=true so
# the rate limiter keys on the client rather than on the proxy (one
# bucket for everyone). Leave it false when nothing stands in front:
# X-Forwarded-For is then whatever the caller writes.
TRUST_PROXY_HEADERS=false
# How many proxies stand in front when it is true. The client is the
# address that many places from the RIGHT of X-Forwarded-For — the one
# your proxy chain appended; the leftmost is what the client wrote.
# One proxy (Traefik, nginx, Caddy): 1. A CDN in front of it too: 2.
TRUSTED_PROXY_HOPS=1
