# 試 · Environment for `cargo run` against docker-compose.test-stack.yml.
# Every value here is a localhost mock. Nothing is secret, nothing is
# reachable from outside this machine. Load with:
#   set -a; source test-stack.env; set +a; cargo run
PORT=3000
POSTGRES_URL=postgres://manga:manga@localhost:54329/mangacollector
FRONTEND_URL=http://localhost:5173

# Mock OpenID Connect (ghcr.io/navikt/mock-oauth2-server). The mock
# accepts any client id / secret and any username on its login page.
AUTH_MODE=openidconnect
AUTH_ISSUER=http://localhost:8484/default
AUTH_CLIENT_ID=mangacollector-test-stack
AUTH_CLIENT_SECRET=mock-provider-accepts-anything
AUTH_NAME="Mock OIDC"
AUTH_ICON="openid"

# Fixed so sessions survive a server restart while iterating. Obviously
# not a real secret — never reuse outside the local test stack.
SESSION_SECRET=test-stack-only-not-a-real-secret-please-do-not-reuse-anywhere-0000

# Local filesystem instead of S3/MinIO; directory is gitignored.
STORAGE_DIR=./.test-stack-storage

# Off so a seed script can add a whole library without tripping tower_governor.
RATE_LIMIT_ENABLED=false
APP_UNSECURE_HEALTHCHECK=true
APP_ENABLE_DOTENV=false
